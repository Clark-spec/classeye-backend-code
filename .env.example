APP_NAME="Class Eye"
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Local Docker defaults only. On Render use DB_URL instead of these values.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=class_eye
DB_USERNAME=class_eye
DB_PASSWORD=secret
DB_SSLMODE=disable
SEED_DEMO_DATA=true

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

SANCTUM_STATEFUL_DOMAINS=localhost:5173
FRONTEND_URL=http://localhost:5173

# Access tokens expire after 8 hours by default. Set to empty to disable.
SANCTUM_EXPIRATION=480

# --- AI assistant (optional) --------------------------------------------
# AI_ENABLED=false keeps everything on-server: the assistant uses local
# template-based analysis and no occupancy data leaves the application.
#
# Free and fully local (Docker runs Ollama too):
#   docker compose -f docker-compose.yml -f docker-compose.ollama.yml up --build
# The override file sets AI_ENABLED, AI_PROVIDER=ollama, AI_BASE_URL and
# AI_MODEL for you, so nothing below has to change.
#
# Free and fully local (Ollama installed on the host, Laravel in Docker):
#   AI_ENABLED=true
#   AI_PROVIDER=ollama
#   AI_BASE_URL=http://host.docker.internal:11434/v1
#   AI_MODEL=llama3.2:1b
#   AI_TIMEOUT_SECONDS=120
#
# Cloud model (paid or free tier), any OpenAI-compatible host:
#   AI_ENABLED=true, AI_PROVIDER=openai|anthropic, AI_API_KEY=..., AI_MODEL=...
#   AI_BASE_URL is only needed for non-vendor hosts such as Groq, Gemini, or
#   OpenRouter. A key is required unless the host is local or private.
AI_ENABLED=false
AI_PROVIDER=heuristic
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_SECONDS=10
AI_MAX_TOKENS=400
AI_MONTHLY_BUDGET_USD=5
AI_QUESTION_MAX_LENGTH=500
AI_CONTEXT_ROOM_LIMIT=30
AI_REDACT_PERSONAL_DATA=true

# --- Occupancy insights --------------------------------------------------
INSIGHTS_WINDOW_HOURS=24
INSIGHTS_FORECAST_MINUTES=30
INSIGHTS_MIN_SNAPSHOTS=3
INSIGHTS_ANOMALY_Z_THRESHOLD=2.5
INSIGHTS_MIN_ANOMALY_CHANGE=3
